# Copiez ce fichier en .env et adaptez les valeurs

PORT=3000
NODE_ENV=development
JWT_SECRET=une-longue-chaine-aleatoire

# Base MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=santemap
# Bases hébergées (Aiven…) : connexion chiffrée et certificat CA
DB_SSL=false
DB_SSL_CA=

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@santemap.ci
ADMIN_PASSWORD=admin12345

# E-mails de notification (facultatif) : n'importe quel serveur SMTP (Brevo, Gmail, Mailjet…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SantéMap <no-reply@votre-domaine.ci>

# Budget total de récompenses par mois, en FCFA, tous membres confondus (0 = sans limite)
ECHANGES_BUDGET_MOIS=100000

# Import des établissements OpenStreetMap (data/osm-ci.json) et données de démonstration
IMPORT_OSM=true
SEED_DEMO=true
