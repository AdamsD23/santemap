# Copiez ce fichier en .env et adaptez les valeurs

PORT=3000
NODE_ENV=development
JWT_SECRET=une-longue-chaine-aleatoire

# Base MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=santemap
# Bases hébergées (Aiven…) : connexion chiffrée et certificat CA
DB_SSL=false
DB_SSL_CA=

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@santemap.ci
ADMIN_PASSWORD=admin12345

# Import des établissements OpenStreetMap (data/osm-ci.json) et données de démonstration
IMPORT_OSM=true
SEED_DEMO=true
